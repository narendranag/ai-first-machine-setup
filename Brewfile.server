# Brewfile.server — headless Macs, on top of Brewfile.
# Linux boxes don't use Brewfiles; their packages are recorded in docs/machines/<box>.md.
# Install: brew bundle --file Brewfile.server

cask "orbstack"                         # containers: Bugsink, self-hosted services
brew "cloudflared"                      # Cloudflare Tunnel for services exposed to the internet
